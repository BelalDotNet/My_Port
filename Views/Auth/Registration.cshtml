                    var registerBtn  = document.getElementById('registerBtn');

                    function validateConfirm() {
                        var pass    = passInput.value;
                        var confirm = confirmInput.value;

                        if (confirm === '') {
                            confirmError.textContent = '';
                            confirmOk.textContent    = '';
                            return;
                        }

                        if (pass !== confirm) {
                            confirmError.textContent        = '✖ Passwords do not match.';
                            confirmOk.textContent           = '';
                            confirmInput.style.borderColor  = '#dc3545';
                        } else {
                            confirmOk.textContent           = '✔ Passwords match.';
                            confirmError.textContent        = '';
                            confirmInput.style.borderColor  = '#28a745';
                        }
                    }

                    // Validate on every keystroke in either field
                    confirmInput.addEventListener('input', validateConfirm);
                    passInput.addEventListener('input', validateConfirm);

                    // Block form submit if passwords don't match
                    document.getElementById('registerForm').addEventListener('submit', function (e) {
                        if (passInput.value !== confirmInput.value) {
                            e.preventDefault();
                            confirmError.textContent       = '✖ Passwords do not match. Please fix before Registration.';
                            confirmOk.textContent          = '';
                            confirmInput.style.borderColor = '#dc3545';
                            confirmInput.focus();
                        }
                    });
                </script>

