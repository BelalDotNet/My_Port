<div class="register-box">
    <div class="register-logo">
        <a href="#"><b>My</b>Portfolio</a>
    </div>

    <div class="card border-0 shadow-lg" style="border-radius:20px;">
        <div class="card-body register-card-body px-4 py-4" style="border-radius:20px; background:rgba(255,255,255,0.97);">

            <p class="login-box-msg font-weight-bold text-muted">
                Register a new user
            </p>

            <form asp-action="RegisterUser" id="registerForm">

               @*  {{-- Full Name --}} *@
                <div class="input-group mb-3">
                    <input type="text"
                           class="form-control"
                           placeholder="Full name"
                           name="UserName"
                           asp-for="UserName"
                           style="border-radius: 12px 0 0 12px !important;
                        border: 1.5px solid #dee2e6;
                        padding: 11px 16px;
                        font-size: 14px;">
                        <div class="input-group-append">
                            <div class="input-group-text"
                                 style="border-radius: 0 12px 12px 0 !important;
                                border: 1.5px solid #dee2e6;
                                border-left: 0;
                                background: #f8f9fa;">
                                <span class="fas fa-user text-muted"></span>
                            </div>
                        </div>
                    </div>

                  @*   {{-- Email --}} *@
                    <div class="input-group mb-3">
                        <input type="email"
                               class="form-control"
                               placeholder="Email"
                               name="Email"
                               asp-for="Email"
                               style="border-radius: 12px 0 0 12px !important;
                            border: 1.5px solid #dee2e6;
                            padding: 11px 16px;
                            font-size: 14px;">
                            <div class="input-group-append">
                                <div class="input-group-text"
                                     style="border-radius: 0 12px 12px 0 !important;
                                    border: 1.5px solid #dee2e6;
                                    border-left: 0;
                                    background: #f8f9fa;">
                                    <span class="fas fa-envelope text-muted"></span>
                                </div>
                            </div>
                        </div>
@* 
                        {{-- Password --}} *@
                        <div class="input-group mb-1">
                            <input type="password"
                                   class="form-control"
                                   placeholder="Password"
                                   name="Password"
                                   asp-for="Password"
                                   id="passwordInput"
                                   style="border-radius: 12px 0 0 12px !important;
                                border: 1.5px solid #dee2e6;
                                padding: 11px 16px;
                                font-size: 14px;">
                                <div class="input-group-append">
                                    <div class="input-group-text"
                                         onclick="togglePassword()"
                                         style="border-radius: 0 12px 12px 0 !important;
                                        border: 1.5px solid #dee2e6;
                                        border-left: 0;
                                        background: #f8f9fa;
                                        cursor: pointer;">
                                        <span class="fas fa-eye text-muted" id="eyeIcon"></span>
                                    </div>
                                </div>
                            </div>
                            <div class="mb-3">
                                <span asp-validation-for="Password" class="text-danger" style="font-size:12px;"></span>
                            </div>

                           @*  {{-- Confirm Password --}} *@
                            <div class="input-group mb-1">
                                <input type="password"
                                       class="form-control"
                                       placeholder="Retype password"
                                       name="ConfirmPassword"
                                       id="confirmPassword"
                                       style="border-radius: 12px 0 0 12px !important;
                                    border: 1.5px solid #dee2e6;
                                    padding: 11px 16px;
                                    font-size: 14px;">
                                    <div class="input-group-append">
                                        <div class="input-group-text"
                                             onclick="toggleConfirmPassword()"
                                             style="border-radius: 0 12px 12px 0 !important;
                                            border: 1.5px solid #dee2e6;
                                            border-left: 0;
                                            background: #f8f9fa;
                                            cursor: pointer;">
                                            <span class="fas fa-eye text-muted" id="eyeIconConfirm"></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <span id="confirmError" class="text-danger" style="font-size:12px;"></span>
                                    <span id="confirmSuccess" class="text-success" style="font-size:12px;"></span>
                                </div>

                                <div class="row mt-1">
                                    <div class="col-12">
                                        <button type="submit"
                                                id="registerBtn"
                                                class="btn btn-primary btn-block font-weight-bold"
                                                style="border-radius: 12px;
                                            padding: 11px;
                                            font-size: 14px;
                                            letter-spacing: 0.4px;">
                                            Register
                                        </button>
                                    </div>
                                </div>

                            </form>

                            <p class="mt-3 mb-0 text-center text-muted" style="font-size:16px;">
                                Already Registered? Login
                                <a asp-action="RegisterToLogin" class="font-weight-bold"> Here</a>
                            </p>

                        </div>
                    </div>
                </div>

                <script>
                    function togglePassword() {
                        var input = document.getElementById('passwordInput');
                        var icon  = document.getElementById('eyeIcon');
                        if (input.type === 'password') {
                            input.type = 'text';
                            icon.classList.remove('fa-eye');
                            icon.classList.add('fa-eye-slash');
                        } else {
                            input.type = 'password';
                            icon.classList.remove('fa-eye-slash');
                            icon.classList.add('fa-eye');
                        }
                    }

                    function toggleConfirmPassword() {
                        var input = document.getElementById('confirmPassword');
                        var icon  = document.getElementById('eyeIconConfirm');
                        if (input.type === 'password') {
                            input.type = 'text';
                            icon.classList.remove('fa-eye');
                            icon.classList.add('fa-eye-slash');
                        } else {
                            input.type = 'password';
                            icon.classList.remove('fa-eye-slash');
                            icon.classList.add('fa-eye');
                        }
                    }

                    var passInput    = document.getElementById('passwordInput');
                    var confirmInput = document.getElementById('confirmPassword');
                    var confirmError = document.getElementById('confirmError');
                    var confirmOk    = document.getElementById('confirmSuccess');

                    function validateConfirm() {
                        var pass    = passInput.value;
                        var confirm = confirmInput.value;

                        if (confirm === '') {
                            confirmError.textContent       = '';
                            confirmOk.textContent          = '';
                            confirmInput.style.borderColor = '#dee2e6';
                            return;
                        }
                        if (pass !== confirm) {
                            confirmError.textContent       = '✖ Passwords do not match.';
                            confirmOk.textContent          = '';
                            confirmInput.style.borderColor = '#dc3545';
                        } else {
                            confirmOk.textContent          = '✔ Passwords match.';
                            confirmError.textContent       = '';
                            confirmInput.style.borderColor = '#28a745';
                        }
                    }

                    confirmInput.addEventListener('input', validateConfirm);
                    passInput.addEventListener('input', validateConfirm);

                    document.getElementById('registerForm').addEventListener('submit', function (e) {
                        if (passInput.value !== confirmInput.value) {
                            e.preventDefault();
                            confirmError.textContent       = '✖ Passwords do not match. Please fix before submitting.';
                            confirmOk.textContent          = '';
                            confirmInput.style.borderColor = '#dc3545';
                            confirmInput.focus();
                        }
                    });
                </script>



           