@using My_Port.Dto
@model RoleDto

<div>@ViewBag.Message</div>
<form class="container d-flex justify-content-center align-items-center vh-100" asp-action="UpdateRoleDetails">
    <div class="card p-4 shadow" style="width: 400px;">
        <h3 class="text-center mb-4">Update Role</h3>

        <div class="mb-3">
            <label class="form-label">Role Name</label>
            <input type="text" class="form-control" placeholder="Enter role name" name="RoleName" value="@Model.RoleName" asp-for="RoleName">
            </div>

            <div class="mb-3">
                <label class="form-label">Role Description</label>
                <input type="text" class="form-control" placeholder="Enter role description" name="RoleDescription" value="@Model.RoleDescription" asp-for="RoleDescription">
                </div>
                <input type="hidden" name="RoleId"  asp-for="RoleId" />

                        <div class="d-grid">
                            <button class="btn btn-success">Submit</button>
                        </div>
                    </div>
                </form>